{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('meta/host').val() === auth.uid",

        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || (newData.child('host').val() === auth.uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && root.child('rooms/' + $code + '/presence/' + data.child('host').val() + '/online').val() === false))",
          ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['host', 'status'])",
          "host": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
          "created": { ".validate": "newData.isNumber()" },
          "settings": {
            "expansion": { ".validate": "newData.isBoolean()" },
            "vpTarget": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 20" },
            "friendlyRobber": { ".validate": "newData.isBoolean()" },
            "specialBuild": { ".validate": "newData.isBoolean()" },
            "balancedBoard": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')) || (!newData.exists() && root.child('rooms/' + $code + '/meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'color', 'joined'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "joined": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "bots": {
          "$bot": {
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
            ".validate": "newData.hasChildren(['name', 'color', 'joined'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "joined": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.hasChildren(['online'])",
            "online": { ".validate": "newData.isBoolean()" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && (newData.exists() || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['seq', 'state'])",
          "seq": { ".validate": "newData.isNumber()" },
          "state": { ".validate": "newData.isString() && newData.val().length < 500000" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": false }
        },

        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.child('uid').val() === auth.uid",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
